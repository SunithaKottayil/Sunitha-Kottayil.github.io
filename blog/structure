        <div class="celebration" id="celebration">
            <h2>🎉 Congratulations!</h2>
            <p>You've completed the Python Data Containers tutorial!</p>
            <div class="score-badge">
                <span>🏆</span>
                <span id="finalScore">Final Score: 0/0</span>
            </div>
            <button class="btn" onclick="restartTutorial()">🔄 Start Over</button>
        </div>
