    <script>
        let currentLesson = 0;
        let totalQuestions = 0;
        let correctAnswers = 0;
        let quizAnswers = [null, null, null, null];

        function showLesson(lessonIndex) {
            // Hide all lessons
            document.querySelectorAll('.lesson').forEach(lesson => {
                lesson.classList.remove('active');
            });

            // Show selected lesson
            document.getElementById(`lesson${lessonIndex}`).classList.add('active');

            // Update lesson tabs
            document.querySelectorAll('.lesson-tab').forEach((tab, index) => {
                tab.classList.remove('active');
                if (index === lessonIndex) {
                    tab.classList.add('active');
                }
                if (index < lessonIndex) {
                    tab.classList.add('completed');
                }
            });

            currentLesson = lessonIndex;
            updateProgress();
        }

        function nextLesson() {
            if (currentLesson < 4) {
                showLesson(currentLesson + 1);
            }
        }

        function prevLesson() {
            if (currentLesson > 0) {
                showLesson(currentLesson - 1);
            }
        }

        function updateProgress() {
            const progress = ((currentLesson + 1) / 5) * 100;
            document.getElementById('progressFill').style.width = progress + '%';
        }

        function runCode(textareaId, outputId) {
            const code = document.getElementById(textareaId).value;
            const output = document.getElementById(outputId);
            
            try {
                // Simple code execution simulation
                let result = '';
                const lines = code.split('\n');
                
                for (let line of lines) {
                    line = line.trim();
                    if (line.startsWith('print(') && line.endsWith(')')) {
                        const content = line.slice(6, -1);
                        result += eval(content) + '\n';
                    } else if (line.includes('=') && !line.startsWith('#')) {
                        // Variable assignment simulation
                        result += `✓ ${line}\n`;
                    } else if (line.startsWith('#')) {
                        result += `💭 ${line}\n`;
                    }
                }
                
                if (result === '') {
                    result = '✓ Code executed successfully! Try adding print() statements to see output.';
                }
                
                output.textContent = result;
            } catch (error) {
                output.textContent = `❌ Error: ${error.message}`;
                output.style.backgroundColor = '#7f1d1d';
                output.style.color = '#fca5a5';
            }
        }

        function selectOption(option, isCorrect) {
            // Remove previous selections in this quiz
            const quiz = option.parentElement;
            quiz.querySelectorAll('.quiz-option').forEach(opt => {
                opt.classList.remove('selected', 'correct', 'incorrect');
            });

            // Mark the selected option
            option.classList.add('selected');
            
            setTimeout(() => {
                quiz.querySelectorAll('.quiz-option').forEach(opt => {
                    if (opt.onclick.toString().includes('true')) {
                        opt.classList.add('correct');
                    } else if (opt.classList.contains('selected') && !isCorrect) {
                        opt.classList.add('incorrect');
                    }
                });

                if (isCorrect) {
                    correctAnswers++;
                    showCelebration('🎉 Correct!');
                } else {
                    showCelebration('❌ Not quite right. Try again!');
                }

                totalQuestions++;
                updateScore();
            }, 500);
        }

        function selectQuizOption(option, isCorrect, questionIndex) {
            // Store answer
            quizAnswers[questionIndex] = isCorrect;
            
            // Remove previous selections in this quiz
            const quiz = option.parentElement;
            quiz.querySelectorAll('.quiz-option').forEach(opt => {
                opt.classList.remove('selected', 'correct', 'incorrect');
            });

            // Mark the selected option
            option.classList.add('selected');
            
            setTimeout(() => {
                quiz.querySelectorAll('.quiz-option').forEach(opt => {
                    if (opt.onclick.toString().includes('true')) {
                        opt.classList.add('correct');
                    } else if (opt.classList.contains('selected') && !isCorrect) {
                        opt.classList.add('incorrect');
                    }
                });

                if (isCorrect) {
                    showCelebration('🎉 Correct!');
                } else {
                    showCelebration('❌ Not quite right, but keep learning!');
                }
            }, 500);
        }

        function showCelebration(message) {
            const celebration = document.getElementById('celebration');
            celebration.style.display = 'block';
            celebration.querySelector('h2').textContent = message;
            celebration.querySelector('p').style.display = 'none';
            celebration.querySelector('.score-badge').style.display = 'none';
            celebration.querySelector('button').style.display = 'none';
            
            setTimeout(() => {
                celebration.style.display = 'none';
            }, 1500);
        }

        function updateScore() {
            const scoreElement = document.getElementById('score');
            scoreElement.textContent = `Score: ${correctAnswers}/${totalQuestions}`;
        }

        function showHint(hintNumber) {
            const hint = document.getElementById(`hint${hintNumber}`);
            hint.style.display = hint.style.display === 'none' ? 'block' : 'none';
        }

        function showSolution(solutionNumber) {
            const solution = document.getElementById(`solution${solutionNumber}`);
            solution.style.display = solution.style.display === 'none' ? 'block' : 'none';
        }

        function finishQuiz() {
            let finalScore = quizAnswers.filter(answer => answer === true).length;
            correctAnswers += finalScore;
            totalQuestions += 4;
            
            const celebration = document.getElementById('celebration');
            const finalScoreElement = document.getElementById('finalScore');
            
            let message = '';
            if (finalScore === 4) {
                message = '🏆 Perfect Score! Outstanding!';
            } else if (finalScore >= 3) {
                message = '🎉 Excellent Work!';
            } else if (finalScore >= 2) {
                message = '👍 Good Job!';
            } else {
                message = '📚 Keep Learning!';
            }
            
            celebration.querySelector('h2').textContent = message;
            celebration.querySelector('p').textContent = `You've completed the Python Data Containers tutorial!`;
            celebration.querySelector('p').style.display = 'block';
            finalScoreElement.textContent = `Final Quiz: ${finalScore}/4`;
            celebration.querySelector('.score-badge').style.display = 'inline-flex';
            celebration.querySelector('button').style.display = 'inline-block';
            celebration.style.display = 'block';
            
            updateScore();
            updateProgress();
        }

        function restartTutorial() {
            currentLesson = 0;
            totalQuestions = 0;
            correctAnswers = 0;
            quizAnswers = [null, null, null, null];
            
            document.getElementById('celebration').style.display = 'none';
            
            // Reset all quiz options
            document.querySelectorAll('.quiz-option').forEach(option => {
                option.classList.remove('selected', 'correct', 'incorrect');
            });
            
            // Reset all code inputs
            document.querySelectorAll('.code-input').forEach(input => {
                input.value = input.getAttribute('placeholder') || '';
            });
            
            // Reset all outputs
            document.querySelectorAll('.output').forEach(output => {
                output.textContent = '';
                output.style.backgroundColor = '#064e3b';
                output.style.color = '#d1fae5';
            });
            
            // Hide all hints and solutions
            document.querySelectorAll('.hint').forEach(hint => {
                hint.style.display = 'none';
            });
            
            showLesson(0);
            updateScore();
        }

        // Initialize the tutorial
        updateProgress();
        updateScore();

