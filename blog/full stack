<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Full-Stack Development: Complete IDE Tutorial</title>
    <meta name="description" content="Complete full-stack development guide with IDE-like interface and real code examples">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            background: #1e1e1e;
            color: #d4d4d4;
            line-height: 1.6;
            font-size: 14px;
        }

        .ide-container {
            display: flex;
            height: 100vh;
            background: #1e1e1e;
        }

        .sidebar {
            width: 250px;
            background: #252526;
            border-right: 1px solid #3c3c3c;
            overflow-y: auto;
        }

        .file-explorer {
            padding: 10px 0;
        }

        .folder-item {
            padding: 5px 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: #cccccc;
        }

        .folder-item:hover {
            background: #2a2d2e;
        }

        .folder-item::before {
            content: '📁';
            margin-right: 8px;
            font-size: 16px;
        }

        .file-item {
            padding: 5px 15px 5px 35px;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: #cccccc;
        }

        .file-item:hover {
            background: #2a2d2e;
        }

        .file-item::before {
            content: '📄';
            margin-right: 8px;
            font-size: 14px;
        }

        .file-item.html::before { content: '🌐'; }
        .file-item.css::before { content: '🎨'; }
        .file-item.js::before { content: '⚡'; }
        .file-item.json::before { content: '📋'; }
        .file-item.sql::before { content: '🗄️'; }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .tab-bar {
            background: #2d2d30;
            border-bottom: 1px solid #3c3c3c;
            display: flex;
            align-items: center;
            padding: 0 10px;
            height: 35px;
        }

        .tab {
            padding: 8px 15px;
            background: #1e1e1e;
            border-right: 1px solid #3c3c3c;
            cursor: pointer;
            color: #cccccc;
            font-size: 13px;
        }

        .tab.active {
            background: #007acc;
            color: white;
        }

        .tab::before {
            content: '📄';
            margin-right: 5px;
        }

        .editor-container {
            flex: 1;
            display: flex;
        }

        .line-numbers {
            background: #1e1e1e;
            color: #858585;
            padding: 10px 8px;
            border-right: 1px solid #3c3c3c;
            text-align: right;
            font-size: 12px;
            user-select: none;
            min-width: 50px;
        }

        .code-editor {
            flex: 1;
            background: #1e1e1e;
            padding: 10px;
            overflow-y: auto;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.6;
        }

        .code-block {
            background: #1e1e1e;
            border: 1px solid #3c3c3c;
            border-radius: 4px;
            margin: 20px 0;
            overflow: hidden;
        }

        .code-header {
            background: #2d2d30;
            padding: 8px 15px;
            border-bottom: 1px solid #3c3c3c;
            font-size: 12px;
            color: #cccccc;
            display: flex;
            align-items: center;
        }

        .code-header::before {
            content: '💻';
            margin-right: 8px;
        }

        .code-content {
            padding: 15px;
            background: #1e1e1e;
            color: #d4d4d4;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.6;
            white-space: pre-wrap;
            overflow-x: auto;
        }

        .comment { color: #6a9955; }
        .keyword { color: #569cd6; }
        .string { color: #ce9178; }
        .number { color: #b5cea8; }
        .function { color: #dcdcaa; }
        .variable { color: #9cdcfe; }
        .operator { color: #d4d4d4; }
        .tag { color: #569cd6; }
        .attribute { color: #9cdcfe; }

        .section {
            margin: 30px 0;
            padding: 20px;
            background: #252526;
            border-radius: 4px;
            border-left: 4px solid #007acc;
        }

        .section h2 {
            color: #007acc;
            margin-bottom: 15px;
            font-size: 18px;
            display: flex;
            align-items: center;
        }

        .section h2::before {
            content: '📚';
            margin-right: 10px;
        }

        .section h3 {
            color: #4ec9b0;
            margin: 15px 0 10px 0;
            font-size: 16px;
            display: flex;
            align-items: center;
        }

        .section h3::before {
            content: '📖';
            margin-right: 8px;
        }

        .info-box {
            background: #1e1e1e;
            border: 1px solid #3c3c3c;
            border-radius: 4px;
            padding: 15px;
            margin: 15px 0;
            display: flex;
            align-items: flex-start;
        }

        .info-box::before {
            content: '💡';
            margin-right: 10px;
            font-size: 18px;
        }

        .warning-box {
            background: #1e1e1e;
            border: 1px solid #d7ba7d;
            border-radius: 4px;
            padding: 15px;
            margin: 15px 0;
            display: flex;
            align-items: flex-start;
        }

        .warning-box::before {
            content: '⚠️';
            margin-right: 10px;
            font-size: 18px;
        }

        .success-box {
            background: #1e1e1e;
            border: 1px solid #4ec9b0;
            border-radius: 4px;
            padding: 15px;
            margin: 15px 0;
            display: flex;
            align-items: flex-start;
        }

        .success-box::before {
            content: '✅';
            margin-right: 10px;
            font-size: 18px;
        }

        .step-list {
            list-style: none;
            padding: 0;
        }

        .step-list li {
            padding: 8px 0;
            display: flex;
            align-items: flex-start;
        }

        .step-list li::before {
            content: '🔹';
            margin-right: 10px;
            margin-top: 2px;
        }

        .project-structure {
            background: #1e1e1e;
            border: 1px solid #3c3c3c;
            border-radius: 4px;
            padding: 15px;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.8;
        }

        .folder-line::before { content: '📁'; margin-right: 5px; }
        .file-line::before { content: '📄'; margin-right: 5px; }

        .terminal {
            background: #0c0c0c;
            color: #cccccc;
            padding: 15px;
            border-radius: 4px;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.6;
        }

        .terminal::before {
            content: '💻 Terminal';
            display: block;
            color: #007acc;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .command {
            color: #4ec9b0;
        }

        .output {
            color: #cccccc;
        }

        .error {
            color: #f44747;
        }

        .navigation {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #252526;
            border: 1px solid #3c3c3c;
            border-radius: 4px;
            padding: 10px;
            z-index: 1000;
        }

        .nav-link {
            display: block;
            padding: 5px 10px;
            color: #cccccc;
            text-decoration: none;
            font-size: 12px;
            border-radius: 2px;
        }

        .nav-link:hover {
            background: #2a2d2e;
        }

        .nav-link::before {
            content: '🔗';
            margin-right: 5px;
        }

        @media (max-width: 768px) {
            .ide-container {
                flex-direction: column;
            }
            
            .sidebar {
                width: 100%;
                height: 200px;
            }
            
            .navigation {
                position: static;
                margin: 10px;
            }
        }
    </style>
</head>
